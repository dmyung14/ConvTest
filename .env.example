# Copy this file to `.env.local` to enable optional live source lookups.
#
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   macOS / Linux:       cp .env.example .env.local
#
# Next.js loads `.env.local` automatically, so you do not have to set anything
# in your shell, and it applies no matter which terminal starts the server.
# `.env.local` is gitignored and never committed.
#
# The core demonstration needs none of this. With live sources off, the app
# runs entirely from the illustrative fixture.

# Enables the ClinicalTrials.gov API v2 adapter behind /api/sources.
# No API key exists for this endpoint; it is public.
DECISIONTRACE_ENABLE_LIVE_SOURCES=true
